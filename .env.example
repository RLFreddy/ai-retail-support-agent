# TiendaHogar support agent. Copy to .env; every variable is optional.
# Without an API key the agent runs with the deterministic offline mock model.

# --- Language model -------------------------------------------------------
# Pydantic AI "provider:model" name, or "mock". Examples:
#   groq:openai/gpt-oss-20b (default) · openai:gpt-4.1-mini · ollama:llama3.2
LLM_MODEL=groq:openai/gpt-oss-20b
# The provider reads its own key or endpoint from the environment:
GROQ_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Model requests per question (tool call, answer and one grounding retry).
# MAX_REQUESTS=3
# Plain-text file that replaces the default system prompt.
# SYSTEM_PROMPT_FILE=prompts/support.txt

# --- Retrieval ------------------------------------------------------------
# Empty EMBEDDING_MODEL: lexical BM25 (offline). Set it to use embeddings from
# any OpenAI-compatible endpoint, e.g. bge-m3 on a local TEI server:
#   docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference --model-id BAAI/bge-m3
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=http://localhost:8080/v1
# EMBEDDING_API_KEY=
# Optional cross-encoder reranker on a second TEI server:
#   docker run -p 8001:80 ghcr.io/huggingface/text-embeddings-inference --model-id BAAI/bge-reranker-v2-m3
# RERANK_URL=http://localhost:8001/rerank
# TOP_K=3
# LEXICAL_THRESHOLD=0.5
# SEMANTIC_THRESHOLD=0.56
