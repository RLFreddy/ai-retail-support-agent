# ============ TIENDAHOGAR — Agente de Soporte ============

# --- Modelo de lenguaje (LiteLLM) ---
# Formato LiteLLM: <proveedor>/<modelo>
#   Groq (default, gratuito): groq/openai/gpt-oss-20b | groq/qwen/qwen3-32b
#   OpenRouter: openrouter/anthropic/claude-3.5-haiku ...
#   OpenAI   : openai/gpt-4o-mini
#   Azure OpenAI: azure/gpt-4o-mini (requiere AZURE_API_BASE, AZURE_API_KEY, AZURE_API_VERSION)
#   Local (Ollama): ollama/llama3.1
LLM_MODEL=groq/openai/gpt-oss-20b

# API keys (deja vacías para modo mock determinista sin red)
GROQ_API_KEY=gsk_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=

# Solo para Azure OpenAI (LLM_MODEL=azure/...)
# AZURE_API_KEY=
# AZURE_API_BASE=https://tu-recurso.openai.azure.com
# AZURE_API_VERSION=2024-02-01

# --- Embeddings (RAG) ---
# EMBEDDING_BACKEND=offline | tei | openrouter | openai | gemini
#   offline    -> TF-IDF determinista (DEFAULT, corre sin red, nada que configurar)
#   tei        -> BAAI/bge-m3 en servidor TEI LOCAL (sin key, dentro del perímetro)
#   openrouter -> qwen/qwen3-embedding-8b (nube)
#   openai     -> text-embedding-3-small (nube, el "popular")
#   gemini     -> text-embedding-004 (nube, el "popular" de Google)
EMBEDDING_BACKEND=offline

# --- Solo si EMBEDDING_BACKEND=tei: servidores TEI locales (2 contenedores) ---
# Lévalos antes con Docker:
#   1) Embeddings (bge-m3):
#      docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference --model-id BAAI/bge-m3
#   2) Reranker (cross-encoder, OPCIONAL para RERANK_ENABLED=true):
#      docker run -p 8001:80 ghcr.io/huggingface/text-embeddings-inference --model-id BAAI/bge-reranker-v2-m3
TEI_BASE_URL=http://localhost:8080/v1
TEI_EMBED_MODEL=openai/BAAI/bge-m3
TEI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
TEI_RERANK_BASE_URL=http://localhost:8001

# --- Rerank (OPCIONAL, desactivado por defecto) ---
RERANK_ENABLED=false
RERANK_MODEL=cohere/rerank-v3.5

# --- Solo si EMBEDDING_BACKEND=openrouter ---
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b

# ===== Matriz de variantes del benchmark (scripts/benchmarks/) =====
# No se setean aquí: cada bm_*.py fuerza SU combo al correr. Solo necesitas:
#   - Groq: la GROQ_API_KEY (ya está arriba).
#   - TEI: levantar el servidor Docker (ver comando arriba); sin key.
#   mock_baseline      -> LLM mock  + TF-IDF offline             (sin red)
#   groq_tfidf         -> Groq      + TF-IDF offline             (key Groq)
#   groq_tei_rerank    -> Groq      + TEI bge-m3 + rerank TEI    (con Docker arriba)
#   groq_tei_no_rerank -> Groq      + TEI bge-m3 sin rerank      (con Docker arriba)
# Para el CLI (uv run python -m src.cli --query=...), este .env define la
# combinación del día: EMBEDDING_BACKEND=offline -> Groq + TF-IDF.
# EMBEDDING_BACKEND=tei + Docker arriba -> Groq + TEI (semántico).

# --- RAG ---
TOP_K=3
# Calibrado para el TF-IDF (scikit-learn): relevante >= 0.24, irrelevante <= 0.14.
# Con EMBEDDING_BACKEND != offline se usa SEMANTIC_THRESHOLD (otra escala).
RELEVANCE_THRESHOLD=0.15

# --- Solo si EMBEDDING_BACKEND != offline: umbral de relevancia por embeddings
# --- (bge-m3 genera cosines en escala ~0.3-0.8; con 0.15 todo pasaba y el
# --- agente citaba de más; 0.60 separa el doc correcto, calibrado con el benchmark).
SEMANTIC_THRESHOLD=0.56

# --- Agente ---
MAX_TURNS=2
# Manual del sistema: "auto" (desde knowledge.py) o ruta a un .txt
SYSTEM_PROMPT=auto
